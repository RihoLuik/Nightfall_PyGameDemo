  "dialogue": [
    {
      "type": "line", "speaker": "Player",
      "line": "Sorry, I can't.",
      "voice": "assets/audio/vera/s3/neutral1", "emotion": "neutral"
    },
    {
      "type": "line", "speaker": "Player",
      "line": "I have some... stuff to do.",
