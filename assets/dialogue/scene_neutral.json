    },
    {
      "type": "line", "speaker": "Player",
      "line": "I... hope you understand.",
      "voice": "assets/audio/vera/s3/neutral4", "emotion": "neutral"
    },
    {
      "type": "line", "speaker": "Partner",
      "line": "It's fine... I understand.",
