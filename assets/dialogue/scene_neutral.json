    },
    {
      "type": "line", "speaker": "Partner",
      "line": "I heard that.",
      "voice": "assets/audio/ellie/s3/neutral3", "emotion": "smiling"
    },
    {
      "type": "line", "speaker": "Player",
      "line": "I know.",
      "voice": "assets/audio/vera/s3/neutral6", "emotion": "smiling"
    },
