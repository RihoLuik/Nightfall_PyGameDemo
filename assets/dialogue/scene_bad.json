{
  "id": "scene_bad",
  "dialogue": [
    {
      "type": "line", "speaker": "Player",
      "line": "Sorry, I'm just... not feeling it.",
      "voice": "assets/audio/vera/s3/bad1", "emotion": "neutral"
    },
    {
      "type": "line", "speaker": "Player",
      "line": "I don't think it's a good idea...",
      "voice": "assets/audio/vera/s3/bad2", "emotion": "neutral"
    },
    {
      "type": "line", "speaker": "Player",
      "line": "Especially with my attitude and all that.",
      "voice": "assets/audio/vera/s3/bad3", "emotion": "neutral"
    },
    {
      "type": "line", "speaker": "Partner",
      "line": "*slight pause and a disappointed exhale*",
      "voice": "assets/audio/ellie/s3/bad1", "emotion": "disappointed"
    },
    {
      "type": "line", "speaker": "Partner",
      "line": "Right... figured, should've seen that coming.",
      "voice": "assets/audio/ellie/s3/bad2", "emotion": "disappointed"
    },
    {
      "type": "line", "speaker": "Partner",
      "line": "*huffs* Shouldn't have even offered it.",
      "voice": "assets/audio/ellie/s3/bad3", "emotion": "disappointed"
    },
    {
      "type": "line", "speaker": "Partner",
      "line": "I'll see you on Monday.",
      "voice": "assets/audio/ellie/s3/bad4", "emotion": "annoyed"
    },
    {
      "type": "line", "speaker": "Partner",
      "line": "If you're late again then I'm writing you up.",
      "voice": "assets/audio/ellie/s3/bad5", "emotion": "annoyed"
    },
    {
      "type": "line", "speaker": "Partner",
      "line": "Just keep that in mind.",
      "voice": "assets/audio/ellie/s3/bad6", "emotion": "annoyed"
    },
    {
      "type": "line", "speaker": "Player",
      "line": "Yeah, yeah, sure, whatever.",
      "voice": "assets/audio/vera/s3/bad4", "emotion": "neutral"
    },
    {
      "type": "line", "speaker": "Partner",
      "line": "*muttering under breath* Pendejo...",
      "voice": "assets/audio/ellie/s3/bad7", "emotion": "annoyed"
    },
    {
      "type": "image_screen",
      "image": "assets/images/badend.png"
    }
  ]
}