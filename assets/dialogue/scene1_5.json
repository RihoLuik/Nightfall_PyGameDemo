{
  "id": "scene1_5",
  "dialogue": [
    {
      "type": "line", "speaker": "Partner",
      "line": "Alright we're he-",
      "voice": "assets/audio/ellie/s1_5/line1", "emotion": "neutral"
    },
    {
      "type": "narration",
      "line": "Two robbers appear out of nowhere from a store",
      "voice": "assets/audio/sfx/glass_shatter"
    },
    {
      "type": "line", "speaker": "Partner",
      "line": "Christ!",
      "voice": "assets/audio/ellie/s1_5/line2", "emotion": "shocked"
    },
    {
      "type": "line", "speaker": "Partner",
      "line": "GET BACK HERE!",
      "voice": "assets/audio/ellie/s1_5/line3", "emotion": "serious"
    },
    {
      "type": "line", "speaker": "Partner",
      "line": "GO GET THE OTHER ONE!",
      "voice": "assets/audio/ellie/s1_5/line4", "emotion": "serious"
    },
    {
      "type": "narration",
      "line": "Partner leaves and Player goes after the second one",
      "voice": "assets/audio/sfx/footsteps1"
    },
    {
      "type": "line", "speaker": "Player",
      "line": "GET BACK HERE!",
      "voice": "assets/audio/vera/s1_5/line1", "emotion": "serious"
    },
    {
      "type": "line", "speaker": "Player",
      "line": "Ugh... fuck...",
      "voice": "assets/audio/vera/s1_5/line2", "emotion": "annoyed"
    },
    {
      "type": "narration",
      "line": "Player looks around: two routes, two choices: keep chasing or cut them off",
      "voice": "assets/audio/sfx/footsteps2"
    },
    {
      "type": "choice", "timer": 2,
      "choices": [
        {
          "text": "Don't catch.", "points": -1,
          "branch": [
            {
              "type": "line", "speaker": "Player",
              "line": "Fuck it.",
              "voice": "assets/audio/vera/s1_5/fail1", "emotion": "serious"
            },
            {
              "type": "narration",
              "line": "Player continues running after 'em but fails to catch 'em",
              "voice": "assets/audio/sfx/footsteps3"
            },
            {
              "type": "line", "speaker": "Player",
              "line": "SHIT!",
              "voice": "assets/audio/vera/s1_5/fail2", "emotion": "annoyed"
            },
            {
              "type": "line", "speaker": "Player",
              "line": "I should've been faster...",
              "voice": "assets/audio/vera/s1_5/fail3", "emotion": "annoyed"
            },
            {
              "type": "narration",
              "line": "Partner approaches from behind with the first robber",
              "voice": "assets/audio/sfx/footsteps3"
            },
            {
              "type": "line", "speaker": "Partner",
              "line": "Where's the second one?",
              "voice": "assets/audio/ellie/s1_5/fail1", "emotion": "confused"
            },
            {
              "type": "line", "speaker": "Partner",
              "line": "Don't tell me you let 'em get away...",
              "voice": "assets/audio/ellie/s1_5/fail2", "emotion": "annoyed"
            },
            {
              "type": "line", "speaker": "Player",
              "line": "*panting* ...what do you think?",
              "voice": "assets/audio/vera/s1_5/fail4", "emotion": "annoyed"
            },
            {
              "type": "line", "speaker": "Partner",
              "line": "*sigh* alright, first day on the job, happens.",
              "voice": "assets/audio/ellie/s1_5/fail3", "emotion": "disappointed"
            },
            {
              "type": "line", "speaker": "Partner",
              "line": "We'll find 'em later, let's just-",
              "voice": "assets/audio/ellie/s1_5/fail4", "emotion": "annoyed"
            },
            {
              "type": "line", "speaker": "Partner",
              "line": "Ngh- stay still! Let's just get this bastard back to the precinct...",
              "voice": "assets/audio/ellie/s1_5/fail5", "emotion": "annoyed"
            },
            {
              "type": "line", "speaker": "Partner",
              "line": "We got some interrogation to do...",
              "voice": "assets/audio/ellie/s1_5/fail6", "emotion": "annoyed"
            },
            {
              "type": "scene_jump",
              "target": "scene2"
            }
          ]
        },
        {
          "text": "Catch!", "points": 1,
          "branch": [
            {
              "type": "line", "speaker": "Player",
              "line": "This should cut 'em off.",
              "voice": "assets/audio/vera/s1_5/catch1", "emotion": "serious"
            },
            {
              "type": "narration",
              "line": "Player runs to the alternate path to cut 'em off",
              "voice": "assets/audio/sfx/footsteps3"
            },
            {
              "type": "line", "speaker": "Player",
              "line": "Alright... any moment now... *takes a steady breath- holds it- body flickers, then fades from sight*",
              "voice": "assets/audio/vera/s1_5/catch2", "emotion": "serious"
            },
            {
              "type": "narration",
              "line": "2nd robber runs through the path",
              "voice": "assets/audio/sfx/footsteps3"
            },
            {
              "type": "line", "speaker": "Robber2",
              "line": "Think she gave up... fuck yeah!",
              "voice": "assets/audio/robber2/line1", "emotion": "neutral"
            },
            {
              "type": "narration",
              "line": "Player kicks a nearby trash can over to make 'em slip",
              "voice": "assets/audio/sfx/footsteps3"
            },
            {
              "type": "line", "speaker": "Robber2",
              "line": "WAITWAIT-!",
              "voice": "assets/audio/robber2/line2", "emotion": "neutral"
            },
            {
              "type": "narration",
              "line": "Player leaps onto the robber",
              "voice": "assets/audio/vera/grunt"
            },
            {
              "type": "line", "speaker": "Player",
              "line": "GOTCHA!",
              "voice": "assets/audio/vera/s1_5/catch3", "emotion": "smiling"
            },
            {
              "type": "line", "speaker": "Player",
              "line": "oops...",
              "voice": "assets/audio/vera/s1_5/catch4", "emotion": "neutral"
            },
            {
              "type": "line", "speaker": "Player",
              "line": "Guess I'll just carry them back to her... *picks up the second robber*",
              "voice": "assets/audio/vera/s1_5/catch5", "emotion": "neutral"
            },
            {
              "type": "line", "speaker": "Player",
              "line": "Got 'em...",
              "voice": "assets/audio/vera/s1_5/catch6", "emotion": "neutral"
            },
            {
              "type": "line", "speaker": "Partner",
              "line": "That's good... what happened to 'em?",
              "voice": "assets/audio/ellie/s1_5/catch1", "emotion": "confused"
            },
            {
              "type": "line", "speaker": "Player",
              "line": "They uh... they ran into a wall. Yeah. A wall.",
              "voice": "assets/audio/vera/s1_5/catch7", "emotion": "nervous"
            },
            {
              "type": "line", "speaker": "Partner",
              "line": "Okay...? Well, let's bring 'em to the precinct.",
              "voice": "assets/audio/ellie/s1_5/catch2", "emotion": "neutral"
            },
            {
              "type": "line", "speaker": "Partner",
              "line": "It's break time soon anyway.",
              "voice": "assets/audio/ellie/s1_5/catch3", "emotion": "neutral"
            },
            {
              "type": "line", "speaker": "Player",
              "line": "Oh, right, okay.",
              "voice": "assets/audio/vera/s1_5/catch8", "emotion": "neutral"
            },
            {
              "type": "line", "speaker": "Partner",
              "line": "You okay? You're breathing heavily.",
              "voice": "assets/audio/ellie/s1_5/catch4", "emotion": "concerned"
            },
            {
              "type": "line", "speaker": "Player",
              "line": "I'll be fine, just ran a bit faster than I'm used to.",
              "voice": "assets/audio/vera/s1_5/catch9", "emotion": "neutral"
            },
            {
              "type": "line", "speaker": "Partner",
              "line": "Alright.",
              "voice": "assets/audio/ellie/s1_5/catch5", "emotion": "neutral"
            },
            {
              "type": "scene_jump",
              "target": "scene2"
            }
          ]
        }
      ]
    }
  ]
}